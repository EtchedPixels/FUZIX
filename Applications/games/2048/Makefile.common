include $(FUZIX_ROOT)/Target/rules.$(USERCPU)

APPS = 2048

ifeq ($(TARGET),rpipico)
CFLAGS := -I$(FUZIX_ROOT)/Library/include $(CFLAGS)
endif

# Append optimization flags without overwriting platform-specific CFLAGS
CFLAGS := $(CFLAGS) -Os

app_2048_SRCS = board.c draw.c main.c
app_2048_OBJS = $(app_2048_SRCS:.c=.o)

OBJS = $(app_2048_OBJS)

.PHONY: all
all: $(APPS)

MAPS = $(APPS:=.map)

# Build rule
2048: $(app_2048_OBJS)

$(APPS):
#	Change the order of -ltermcap$(USERCPU) $(LINKER_TAIL) and add -lc$(USERCPU)
#	$(LINKER) $(LINKER_OPT) -o $@ $(CRT0) $^ -ltermcap$(USERCPU) $(LINKER_TAIL)
	$(LINKER) $(LINKER_OPT) -o $@ $(CRT0) $^ $(LINKER_TAIL) -lc$(USERCPU) -ltermcap$(USERCPU)

# Clean up
clean:
	rm -f $(OBJS) $(APPS) $(MAPS)
